# ================================================================
# D-MERS (Disaster Management and Emergency Response System)
# Environment & Configuration Template
# Copy this file to .env or update config/db.properties
# ================================================================

# Supabase Authentication & REST API Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase PostgreSQL Database Connection
# Connection String format: jdbc:postgresql://db.your-project.supabase.co:5432/postgres
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=your-database-password-here

# Local Fallback Configuration (SQLite is automatically used if Supabase is offline)
USE_SQLITE_FALLBACK=true
